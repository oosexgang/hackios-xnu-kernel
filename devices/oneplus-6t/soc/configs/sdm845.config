# HakiOS fragment: the Qualcomm SDM845 -- what is true of the SoC, whatever phone it is in.
# Eight cores, the big ones 4-7 (the kernel is started on core 7, as on SC7280). The SC7280 family's drivers (cpufreq, socinfo,
# thermal, PMIC) are not turned on: their addresses and tables are that family's, and each needs SDM845's before it is.
CONFIG_SOC="sdm845"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
