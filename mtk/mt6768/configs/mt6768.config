# HakiOS fragment: the MediaTek MT6768 (Helio G85) -- what is true of the SoC, whatever phone it is in. Laid over common_defconfig,
# which is the Qualcomm phone's: every driver of that SoC is left out of the kernel here (they would read Qualcomm's addresses), and
# the MediaTek drivers of mtk/mt6768/drivers/ are put in. They are `default n`, so no other configuration gets them by accident.
#
# Four cores, as mtkloader starts them: core 0 (an A55, where LK leaves the boot), then the two A75s, then A55s (its core_order).
# The loader passes the rest itself: the root (rd=md0 emmc_root=1), the panel's size, the clock.
CONFIG_SOC="mt6768"
CONFIG_CPUS=4
# Qualcomm's: the storage, the touch screen and buttons on the PMIC, the Adreno, the DSPs, the modem, Wi-Fi, the chip's identity
# and sensors, the battery, the clocks
# CONFIG_UFS is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# QEMU's
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
# The MT6768's: the eMMC (MSDC0, read only), the keypad and the big cores' clock, the SCP sensor hub, the Mali-G52, CONNSYS
CONFIG_HAKIOS_MTK_EMMC=y
CONFIG_HAKIOS_MTK_KEYS=y
CONFIG_HAKIOS_MTK_SCP=y
CONFIG_HAKIOS_MALI=y
CONFIG_HAKIOS_MTK_CONNSYS=y
