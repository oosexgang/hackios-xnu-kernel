# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
# rc.jobs.scroll with cputop beside it (src/cputop.c): which processes take the processors while the frames are
# measured, every 5 s in the log (RC_JOBS=rc.jobs.cputop, touch_lat=1 cpuload=100; tools/frames.py for the frames).
/redwood/bin/cputop 5 &
/redwood/bin/rwtouch wait 30 swipe 0.5 0.985 0.5 0.3 200 wait 8
/redwood/bin/rwtouch swipe 0.85 0.5 0.15 0.5 300 wait 1 swipe 0.15 0.5 0.85 0.5 300 wait 1 swipe 0.85 0.5 0.15 0.5 300 wait 1 swipe 0.15 0.5 0.85 0.5 300 wait 1 swipe 0.85 0.5 0.15 0.5 300 wait 1 swipe 0.15 0.5 0.85 0.5 300 wait 2
/redwood/bin/rwtouch tap 0.615 0.71 wait 5 zigzag 0.5 0.75 0.35 500 6 wait 2 swipe 0.5 0.8 0.5 0.3 150 wait 2 swipe 0.5 0.3 0.5 0.8 150 wait 2 button home wait 3
/redwood/bin/fps_info
